# Settings for all ParkWise components. Export them or copy to .env (never commit .env).

# PostgreSQL (docker-compose.yml, web-app, data-collector, analytics-ml)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=iotdb
DB_USER=postgres
DB_PASSWORD=change-me
DB_URL=jdbc:postgresql://localhost:5432/iotdb

# data-collector: SFTP server where sensor readings are dropped as JSON files
SFTP_HOST=localhost
SFTP_PORT=22
SFTP_USER=parkwise
SFTP_PASSWORD=change-me
SFTP_DIR=/tmp/testdata/
SPOT_ID=4

# analytics-ml/model_api.py: free key from https://www.weatherapi.com
WEATHER_API_KEY=

# web-app: where the prediction API runs
AI_MODEL_URL=http://localhost:8000
